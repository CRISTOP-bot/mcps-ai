# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of authorized Telegram user IDs
TELEGRAM_ALLOWED_USERS=

# OpenCode Server URL
OPENCODE_BASE_URL=http://127.0.0.1:4096

# OpenCode Server password (from service.json)
OPENCODE_PASSWORD=

# Working directory for OpenCode
OPENCODE_DIRECTORY=/home/cristopher

# Database path
DATABASE_PATH=./data/telegram.db

# Request timeout in seconds
REQUEST_TIMEOUT=0

# Poll interval for getUpdates
POLL_INTERVAL=2

# OpenCode model
OPENCODE_MODEL_ID=deepseek-v4.1-flash-free
OPENCODE_MODEL_PROVIDER=opencode

# Telegram max message length
TELEGRAM_MAX_MESSAGE_LENGTH=4096
