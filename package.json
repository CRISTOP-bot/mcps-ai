{
  "name": "mcps-ai",
  "version": "1.4.0",
  "description": "MCPs-AI \u2014 universal MCP servers for AI agents (Claude, OpenCode, Kiro, Cursor, Windsurf, OpenClaw)",
  "bin": {
    "mcps-ai": "cli/bin/mcps-ai.js"
  },
  "files": [
    "cli",
    "agents",
    "skills",
    "README.md",
    "LICENSE",
    "install.md",
    "setup.sh",
    "mcps/**/*.py",
    "mcps/**/*.toml",
    "mcps/**/*.md",
    "mcps/**/*.lock",
    "mcps/**/*.go",
    "mcps/**/*.mod",
    "mcps/**/*.sum",
    "mcps/**/*.txt",
    "mcps/**/*.service",
    "mcps/**/*.sh",
    "mcps/**/*.yml",
    "mcps/**/*.yaml",
    "mcps/**/*.cfg",
    "mcps/**/*.ini",
    "mcps/**/*.plist",
    "mcps/**/.env.example",
    "mcps/**/.python-version",
    "mcps/**/.gitignore",
    "mcps/**/LICENSE"
  ],
  "scripts": {
    "start": "node cli/bin/mcps-ai.js",
    "status": "node cli/bin/mcps-ai.js status",
    "doctor": "node cli/bin/mcps-ai.js doctor",
    "test": "node --test cli/tests/cli.test.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "claude",
    "kiro",
    "cursor",
    "windsurf",
    "openclaw",
    "ai",
    "telegram",
    "whatsapp",
    "minecraft",
    "gmail",
    "filesystem",
    "system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CRISTOP-bot/mcps-ai.git"
  },
  "bugs": "https://github.com/CRISTOP-bot/mcps-ai/issues",
  "homepage": "https://github.com/CRISTOP-bot/mcps-ai#readme",
  "author": "CRISTOP-bot",
  "publishConfig": {
    "access": "public"
  }
}