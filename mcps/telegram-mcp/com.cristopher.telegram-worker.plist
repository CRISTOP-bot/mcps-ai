<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>cristopher.telegram-worker</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/.local/bin/uv</string>
        <string>--directory</string>
        <string>/Users/USERNAME/mcp-servers/telegram-mcp</string>
        <string>run</string>
        <string>telegram_worker.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/mcp-servers/telegram-mcp</string>
    <key>StandardOutPath</key>
    <string>/tmp/telegram-worker.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/telegram-worker.log</string>
</dict>
</plist>
