# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of authorized Telegram user IDs
TELEGRAM_ALLOWED_USERS=

# AI Server URL (any compatible AI server)
AI_BASE_URL=http://127.0.0.1:4096

# AI Server password
AI_PASSWORD=

# Working directory for AI server
AI_DIRECTORY=/home/cristopher

# Database path
DATABASE_PATH=./data/telegram.db

# Request timeout in seconds
REQUEST_TIMEOUT=0

# Poll interval for getUpdates
POLL_INTERVAL=2

# AI model (provider depends on your AI server)
AI_MODEL_ID=deepseek-v4.1-flash-free
AI_MODEL_PROVIDER=opencode

# Telegram max message length
TELEGRAM_MAX_MESSAGE_LENGTH=4096

# AI Server auth username (default: opencode)
AI_AUTH_USER=opencode
